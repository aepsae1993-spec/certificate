# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจาก Supabase (Project Settings > API)

# URL ของโปรเจกต์ Supabase เช่น https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (ใช้ฝั่ง client สำหรับอ่านข้อมูล)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (ความลับ! ใช้เฉพาะฝั่งเซิร์ฟเวอร์ ห้ามเปิดเผย)
SUPABASE_SERVICE_ROLE_KEY=
